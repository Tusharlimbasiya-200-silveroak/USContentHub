# ============================================================
# USContentHub — Environment Variables Template
# Copy this file to .env and fill in values before running locally.
# NEVER commit .env to version control.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-strong-random-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
# On Vercel this is auto-detected from VERCEL_URL. Include custom domains explicitly.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,us-content-hub.vercel.app

# Comma-separated list of trusted CSRF origins (full URL with protocol)
# On Vercel this is auto-detected from VERCEL_URL — only needed for custom domains
DJANGO_CSRF_ORIGINS=http://localhost:8000

# ── Site URL ─────────────────────────────────────────────────
# Used in sitemaps, robots.txt, and email links
SITE_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────
# Required: PostgreSQL only. Use your Neon connection string in production.
#
# LOCAL PostgreSQL (Homebrew install, no SSL):
#   DATABASE_URL=postgres://uscontenthub:uscontenthub_local_2026@localhost:5432/uscontenthub?sslmode=disable
#
# Production PostgreSQL / Neon (SSL required):
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Optional explicit test database name. The DB role must be able to create/drop it,
# or this database must already exist with the right owner/permissions.
DATABASE_TEST_NAME=test_uscontenthub

# ── Cache / Sessions ─────────────────────────────────────────
# Production scale: set Redis/Upstash so cache + rate limits are shared across workers.
# Local fallback uses LocMemCache if this is blank.
# Examples:
#   redis://localhost:6379/0
#   rediss://default:password@host.upstash.io:6379
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ── Security ─────────────────────────────────────────────────
# Set to any non-empty value to enable HTTPS redirect (production only)
DJANGO_SECURE_SSL=1

# ── Google OAuth ─────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth ──────────────────────────────────────────
# Create app at https://portal.azure.com/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Email / SMTP ─────────────────────────────────────────────
# Leave blank to use console backend (emails printed to terminal in dev)
# For Gmail: host=smtp.gmail.com, port=587, use_tls=True
# For SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, password=<api_key>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@uscontenthub.com

# Email address that receives contact form messages
CONTACT_EMAIL=tusharlimbasiya200@gmail.com
