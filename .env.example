# ============================================================
# USContentHub — Environment Variables Template
# Copy this file to .env and fill in values before running locally.
# NEVER commit .env to version control.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-strong-random-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
# On Vercel this is auto-detected from VERCEL_URL — only needed for custom domains
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted CSRF origins (full URL with protocol)
# On Vercel this is auto-detected from VERCEL_URL — only needed for custom domains
DJANGO_CSRF_ORIGINS=http://localhost:8000

# ── Site URL ─────────────────────────────────────────────────
# Used in sitemaps, robots.txt, and email links
SITE_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────
# Leave blank to use SQLite (local dev / Vercel read-only mode)
# PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=

# ── Cache / Sessions ─────────────────────────────────────────
# Leave blank to use signed-cookie sessions (Vercel-compatible)
# Redis: redis://localhost:6379/0
REDIS_URL=

# ── Security ─────────────────────────────────────────────────
# Set to any non-empty value to enable HTTPS redirect (production only)
DJANGO_SECURE_SSL=1

# ── Google OAuth ─────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth ──────────────────────────────────────────
# Create app at https://portal.azure.com/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
