# ============================================================
# USContentHub — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual environments ─────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── Django ──────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ── Environment / secrets ────────────────────────────────────
.env
.env.local
.env.*.local

# ── Windows metadata artifacts ───────────────────────────────
*.Zone.Identifier
Thumbs.db
ehthumbs.db
Desktop.ini

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors / IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Temporary staging directories ────────────────────────────
_tmp_*/

# ── Vercel local cache ────────────────────────────────────────
.vercel/

# ── Testing / Coverage ───────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ── Node (if any tooling added later) ────────────────────────
node_modules/
npm-debug.log*
