# ============================================================
# USContentHub — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual environments ─────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── Django ──────────────────────────────────────────────────
*.log
local_settings.py
media/
# staticfiles/ is intentionally committed — Vercel bundles the repo as the
# deployment artifact, so collectstatic output must be in git.
# Run `python3 manage.py collectstatic --noinput` before each deploy.

# ── Environment / secrets ────────────────────────────────────
.env
.env.local
.env.prod
.env.prod.*
.env.*.local

# ── Windows metadata artifacts ───────────────────────────────
*.Zone.Identifier
*:Zone.Identifier
Thumbs.db
ehthumbs.db
Desktop.ini

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors / IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Temporary staging directories ────────────────────────────
_tmp_*/

# ── Tech-blog agent drafts (review staging) ──
drafts/

# ── Vercel local cache ────────────────────────────────────────
.vercel/

# ── Testing / Coverage ───────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ── Node (if any tooling added later) ────────────────────────
node_modules/
npm-debug.log*

# ── Pinterest setup output (contains board IDs — not sensitive, but local) ───
pinterest_bot/board_ids.json

# ── Claude Code local settings (machine-specific) ──
.claude/settings.local.json
